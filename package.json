{
  "name": "nhl-draft-companion",
  "version": "1.0.0",
  "description": "A TypeScript/Node.js fantasy hockey draft and waiver-wire helper that ranks players using player stats, team stats, strength of schedule, and deployment data (line combos, power play/penalty kill usage), backed by PostgreSQL",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "nodemon --exec ts-node src/index.ts",
    "test": "jest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmkrile/NHLDraftCompanion.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/cmkrile/NHLDraftCompanion/issues"
  },
  "homepage": "https://github.com/cmkrile/NHLDraftCompanion#readme",
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.1",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.ts"
    ]
  }
}